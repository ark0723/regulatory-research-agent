---
config:
  flowchart:
    curve: linear
---
graph TD;
    __start__([__start__]):::first
    model(model)
    tools(tools)
    __end__([__end__]):::last
    __start__ --> model
    model -. structured evaluation .-> __end__
    model -. verification needed .-> tools
    tools -. more verification .-> model
    tools -. sufficient evidence .-> __end__
    classDef default fill:#f2f0ff,line-height:1.2
    classDef first fill-opacity:0
    classDef last fill:#bfb6fc
